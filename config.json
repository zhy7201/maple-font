{
  "$schema": "./source/schema.json",
  "family_name": "Maple Mono",
  "use_hinted": true,
  "pool_size": 4,
  "ligature": true,
  "feature_freeze": {
    "cv01": "enable",
    "cv02": "ignore",
    "cv03": "enable",
    "cv04": "ignore",
    "cv05": "ignore",
    "cv06": "ignore",
    "cv07": "ignore",
    "cv08": "ignore",
    "cv31": "ignore",
    "cv32": "ignore",
    "cv33": "ignore",
    "cv34": "enable",
    "cv35": "enable",
    "cv36": "enable",
    "cv37": "enable",
    "cv38": "ignore",
    "cv39": "ignore",
    "cv40": "ignore",
    "cv41": "ignore",
    "cv61": "ignore",
    "cv62": "ignore",
    "cv63": "ignore",
    "cv96": "ignore",
    "cv97": "enable",
    "cv98": "ignore",
    "cv99": "ignore",
    "ss01": "ignore",
    "ss02": "ignore",
    "ss03": "ignore",
    "ss04": "ignore",
    "ss05": "enable",
    "ss06": "enable",
    "ss07": "enable",
    "ss08": "enable",
    "ss09": "ignore",
    "ss10": "ignore",
    "ss11": "ignore",
    "zero": "enable"
  },
  "nerd_font": {
    "enable": true,
    "version": "3.3.0",
    "mono": false,
    "use_font_patcher": false,
    "glyphs": [
      "--complete"
    ],
    "extra_args": []
  },
  "cn": {
    "enable": true,
    "with_nerd_font": true,
    "fix_meta_table": true,
    "clean_cache": false,
    "narrow": true,
    "use_hinted": false,
    "use_static_base_font": true
  }
}
